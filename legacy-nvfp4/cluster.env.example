# GLM-5.3-Flash-NVFP4 on 2x DGX Spark -- single source of configuration.
# Copy to cluster.env and edit. cluster.env is gitignored.
#
#   cp cluster.env.example cluster.env
#
# Every value below is a deliberate choice. docs/02-parameters.md explains why.

# --- your two nodes -----------------------------------------------------------
# Anything ssh can resolve: mDNS name, /etc/hosts entry, or ~/.ssh/config alias.
HEAD_HOST=spark1.local            # rank 0, serves the API
WORKER_HOST=spark2.local          # rank 1, headless
CLUSTER_USER=nvidia               # the account that owns the containers/units
KIT_DIR=/home/nvidia/glm53        # where this kit is installed on each node

# Optional: only used if the hostnames above stop resolving (mDNS is flaky on
# some networks). Leave blank to disable the fallback.
HEAD_IP=
WORKER_IP=
# Optional explicit ssh key. Blank = whatever your ssh_config already resolves.
SSH_KEY=

# --- the 200Gb link between the two Sparks ------------------------------------
# Connect the two QSFP ports directly and give each end a static address.
# See docs/01-architecture.md for the one-time network setup.
QSFP_IF=enp1s0f1np1               # interface name on BOTH nodes
HEAD_R1=192.168.177.10
WORKER_R1=192.168.177.11
NCCL_IB_HCA=rocep1s0f1            # RoCE device backing QSFP_IF (`ibv_devices`)

# --- model + image ------------------------------------------------------------
GLM53_MODEL=LibertAIDAI/GLM-5.3-Flash-NVFP4
SERVED_MODEL_NAME=glm-5.3-flash-nvfp4
GLM53_IMAGE=glm53-flash-nvfp4-tp2:local   # built by image/build.sh on each node
HF_CACHE=/home/nvidia/hf-cache-glm53      # ~181 GiB of weights land here

# --- API ----------------------------------------------------------------------
# Loopback only, on purpose. Reach it remotely with an SSH port-forward:
#   ssh -N -L 8000:127.0.0.1:8000 <head>
# Do NOT bind 0.0.0.0 unless you intend an unauthenticated model on your LAN.
VLLM_HOST=127.0.0.1
API_PORT=8000

# --- serving profile (see docs/02-parameters.md for the reasoning) ------------
MAX_MODEL_LEN=131072              # NOT the native 1M: KV is the binding limit
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.85       # claim against 121.69 GiB UNIFIED memory/node
KV_CACHE_DTYPE=fp8_ds_mla         # the packed layout the sparse kernel requires
BLOCK_SIZE=256                    # GLM index cache must divide index_kpool*32
ATTENTION_BACKEND=FLASHINFER_MLA_SPARSE_SM120
MOE_BACKEND=marlin                # native FP4 MoE is NOT safe on sm_121
ENFORCE_EAGER=1                   # 1 = --enforce-eager. Empty to try CUDA graphs
REASONING_EFFORT=high
MEM_MARGIN_GIB=3

# --- distributed rendezvous ---------------------------------------------------
# MASTER_ADDR is derived from HEAD_R1 by render-env.sh -- do not set it here, or
# renumbering the QSFP link leaves a stale rendezvous address and the pair hangs
# in parallel_state init with no error until /health never arrives.
MASTER_PORT=25000
