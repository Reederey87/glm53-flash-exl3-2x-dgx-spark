[Unit]
Description=vLLM GLM-5.3 head inference watchdog (bounces the pair when /health lies)

[Service]
Type=oneshot
# Worst case: probe 90s + head stop 90s + container drain 90s + the worker's
# own ExecStartPre (up to 600s) + the head's (up to 1500s). 600s would SIGTERM
# us mid-bounce; the script traps that, but give it room to finish cleanly.
TimeoutStartSec=2700
ExecStart=/usr/bin/bash @KIT_DIR@/watchdog.sh
