[Unit]
Description=GLM-5.3-Flash-FP4-Local health canary and auto-heal
Documentation=file:///home/nvidia/glm53-fp4-local/docs/09-systemd.md

[Service]
Type=oneshot
Environment=HOME=/home/nvidia
Environment=XDG_RUNTIME_DIR=%t
Environment=PATH=/home/nvidia/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
ExecStart=/home/nvidia/glm53-fp4-local/scripts/watchdog.sh
# A restart blocks until the unit's ExecStartPost health gate returns.
TimeoutStartSec=1200
