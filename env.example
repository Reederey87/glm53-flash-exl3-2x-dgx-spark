# GLM-5.3-Flash-FP4-Local on 2x NVIDIA DGX Spark — single source of configuration.
#
#   cp env.example .env
#
# This file is read by ./launch.sh and is passed to the pinned
# eugr/spark-vllm-docker launcher with `--config`. Keep it free of secrets;
# it is gitignored. HF_TOKEN is optional because the model is public.
#
# The serving shape (model, TP, KV cache, MTP depth, context) lives in
# recipes/glm-5.3-flash-fp4-local.yaml. This file configures the cluster and
# the few launcher-level overrides below.

# --- cluster ------------------------------------------------------------------
# head first, worker second. These are example addresses on the CX7 subnet;
# replace them with your pair. Upstream autodiscovery can fill this in when
# you run ./launch.sh without a value (it prompts once and saves the answer).
CLUSTER_NODES="192.0.2.10,192.0.2.11"
# Interfaces on both nodes. Leave ETH_IF/IB_IF empty to let the upstream
# launcher autodetect them.
ETH_IF="enp1s0f1np1"
IB_IF="rocep1s0f1,roceP2p1s0f1"
# Hosts used to copy the ~18 GB image and the ~166 GiB checkpoint. Defaults to
# every node after the head when left empty.
COPY_HOSTS="192.0.2.11"
MASTER_PORT="29501"
CONTAINER_NAME="vllm_node"

# --- pinned launcher ----------------------------------------------------------
# Commit of https://github.com/eugr/spark-vllm-docker that carries the
# FP4-Local GLM-5.3 recipe. Change only when you have re-run the smoke gate.
SPARK_VLLM_REF="0bdc9c94cd89843e1c8f7d7b33df2d5bc746c03d"
SPARK_VLLM_DIR=".vendor/spark-vllm-docker"

# --- serving image ------------------------------------------------------------
# The checkpoint's compressed NVFP4 scales are not in upstream vLLM. This
# B12X image is the supported runtime (see the model card).
IMAGE_REF="eugr/spark-vllm-b12x:latest"
IMAGE_TAG="vllm-node-b12x"
# 1 = pull the latest image and retag it before launch. 0 = use the local tag.
PULL_IMAGE="1"

# --- optional launcher overrides ---------------------------------------------
# These are passed to the recipe runner as CLI overrides. Leave them at the
# recipe defaults unless you are running a deliberate A/B window.
PORT="8000"
# The server has no authentication. Keep loopback and use an SSH tunnel,
# or set this to 0.0.0.0 only on a firewalled network.
HOST="127.0.0.1"
MAX_MODEL_LEN="500000"
GPU_MEMORY_UTILIZATION="0.87"

# Optional. The checkpoint is public; export it in your shell instead of
# writing it here if you prefer not to keep a token on disk.
HF_TOKEN=""
