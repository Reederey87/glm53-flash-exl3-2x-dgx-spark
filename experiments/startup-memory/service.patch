diff --git a/systemd/vllm-glm53fp4.service b/systemd/vllm-glm53fp4.service
--- a/systemd/vllm-glm53fp4.service
+++ b/systemd/vllm-glm53fp4.service
@@ -28,9 +28,10 @@ ExecStartPre=/bin/bash -c 'for i in $(seq 1 120); do ssh -o BatchMode=yes -o Connect
 # A head-only reboot can leave the worker's old vllm_node running. Clear
 # stale ranks before the memory gate; a no-op on a clean boot.
 ExecStartPre=-/home/nvidia/glm53-fp4-local/launch.sh down
-# The 2M arm needs the unified pool back after a crash or a manual stop. CUDA-free
-# excludes page cache, so wait for MemAvailable, not MemFree.
-ExecStartPre=/bin/bash -c 'for i in $(seq 1 120); do a=$(grep "^MemAvailable:" /proc/meminfo | tr -s " " | cut -d" " -f2); [ "${a:-0}" -ge 104857600 ] && exit 0; sleep 5; done; echo "head MemAvailable <100GiB after 600s" >&2; exit 1'
+# Conservative workspace idle policy: both ranks must be free of serving
+# containers, have MemFree >=90 GiB and the pinned 1048576 KiB reserve.
+# This is an idle readiness check, not an estimate of total allocatable UMA.
+ExecStartPre=/home/nvidia/.local/bin/uv run --frozen --no-dev --project /home/nvidia/glm53-fp4-local /home/nvidia/glm53-fp4-local/scripts/wait_cluster_idle.py --worker nvidia@192.168.177.11 --timeout 600
 
 ExecStart=/home/nvidia/glm53-fp4-local/launch.sh
 # 900s covers the warm-cache boot; the first cold boot can take longer, and
